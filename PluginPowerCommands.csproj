<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <SelfContained>true</SelfContained>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    
    <Product>PluginPowerCommands</Product>
    <BaseOutputPath>..\BuildOutput\Quokka\PlugBoard\PluginPowerCommands</BaseOutputPath>
    <Configurations>Plugin</Configurations>

    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Optimize>True</Optimize>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quokka\Quokka.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ContentWithTargetPath Include="settings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>settings.json</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>

  <ItemGroup>
    <ContentWithTargetPath Include="Icons By Icons8.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>Icons By Icons8.txt</TargetPath>
    </ContentWithTargetPath>

    <ContentWithTargetPath Include="sleep.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>sleep.png</TargetPath>
    </ContentWithTargetPath>
    <ContentWithTargetPath Include="shutdown.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>shutdown.png</TargetPath>
    </ContentWithTargetPath>
    <ContentWithTargetPath Include="restart.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>restart.png</TargetPath>
    </ContentWithTargetPath>
    <ContentWithTargetPath Include="lock.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>lock.png</TargetPath>
    </ContentWithTargetPath>
    <ContentWithTargetPath Include="signOut.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>signOut.png</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>

</Project>
